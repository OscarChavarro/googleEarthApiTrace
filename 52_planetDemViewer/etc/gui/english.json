{
  "format": "vitral-widget-gui",
  "version": 1,
  "menubar": {
    "type": "menu",
    "name": "GLOBAL",
    "children": [
      {
        "type": "menu",
        "name": "&File",
        "children": [
          { "type": "item", "name": "E&xit", "modifiers": ["IDC_FILE_QUIT"] }
        ]
      },
      {
        "type": "menu",
        "name": "&Settings",
        "children": [
          {
            "type": "menu",
            "name": "&Language",
            "children": [
              { "type": "item", "name": "&English", "modifiers": ["IDC_CUSTOMIZE_LANGUAGE_ENGLISH"] },
              { "type": "item", "name": "&Spanish (Español)", "modifiers": ["IDC_CUSTOMIZE_LANGUAGE_SPANISH"] }
            ]
          }
        ]
      }
    ]
  },
  "messages": {
    "IDM_WINDOW_TITLE": "planetDemViewer - Interactive DEM Viewer",
    "IDM_LAYERS_TITLE": "Layers",
    "IDM_LAYER_ELEVATION": "Elevation (FABDEM)",
    "IDM_LAYER_ELEVATION_MESH": "3D terrain",
    "IDM_LAYER_ELEVATION_PALETTE": "Palette image (2D)",
    "IDM_LAYER_COLOR": "Color (Google Earth)",
    "IDM_LAYER_COLOR_OFF": "Off",
    "IDM_LAYER_COLOR_IMAGERY": "Imagery on terrain",
    "IDM_LAYER_SUBDIVISION": "Edge subdivision",
    "IDM_LAYER_SUBDIVISION_TRIANGLE_EDGE": "Triangle edge",
    "IDM_LAYER_SUBDIVISION_DIAMOND_SQUARE": "Diamond-square",
    "IDM_LAYER_SUBDIVISION_LIND1996": "LIND1996",
    "IDM_HUD_NO_IMAGE": "No DEM pyramid loaded. Press 'l' to load one.",
    "IDM_HUD_IMAGE": "Image {0}/{1}: {2} | indexed {3} tiles / depth {4} | metadata queue {5} | opacity {6} | z {7}",
    "IDM_HUD_CAMERA": "PSC: {0} | camera z: {1} | GPU tiles: {2} ({3} MB) | {4}",
    "IDM_HUD_VIEWS_LAYOUT": "views: {0} (layout {1}) | selected: {2}",
    "IDM_HUD_VIEWS_FULL_SCREEN": "views: {0} (full-screen) | selected: {1}",
    "IDM_HUD_VIEW_TITLE": "View {0}",
    "IDM_HUD_MODE": "Mode: {0} | height exaggeration: {1} | terrain meshes: {2} ({3} MB) | uniform LOD: {4} | subdivision: {5} | SPACE: next mode | height: 5/6",
