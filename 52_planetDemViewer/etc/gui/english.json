    "IDM_HUD_KEYS": "Zoom: wheel/z/Z | Reset: r/R | Load: l | Image: 1/2 | Opacity: o/O | Stack z: PgUp/PgDn | Bounds: 0 | Uniform LOD: 9 | Imagery: t | State: e/E | View: ./,/w/v/V | Full screen: Ctrl+F | ESC: exit",
    "IDM_HUD_FPS": "FPS: {0}",
    "IDM_HUD_TILE_RAM": "Tile RAM: {0}",
    "IDM_HUD_TILE_GPU": "Tile GPU: {0}",
    "IDM_HUD_SURFACE": "Surface: {0}°, {1}° | MSL: {2} m",
