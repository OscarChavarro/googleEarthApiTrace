{
  "schemaVersion": 1,
  "dialogs": [
    {
      "id": "layers.panel",
      "titleKey": "IDM_LAYERS_TITLE",
      "modal": false,
      "content": [
        {
          "kind": "tree", "id": "layerTree", "binding": "layers",
          "children": [
            {
              "kind": "column", "id": "elevation", "labelKey": "IDM_LAYER_ELEVATION",
              "children": [
                { "kind": "action", "id": "elevation.mesh", "action": "showTerrainMesh", "labelKey": "IDM_LAYER_ELEVATION_MESH" },
                { "kind": "action", "id": "elevation.palette", "action": "showPaletteImage", "labelKey": "IDM_LAYER_ELEVATION_PALETTE" }
              ]
            },
            {
              "kind": "column", "id": "color", "labelKey": "IDM_LAYER_COLOR",
              "children": [
                { "kind": "action", "id": "color.off", "action": "hideImagery", "labelKey": "IDM_LAYER_COLOR_OFF" },
                { "kind": "action", "id": "color.imagery", "action": "showImagery", "labelKey": "IDM_LAYER_COLOR_IMAGERY" }
              ]
            },
            {
              "kind": "column", "id": "subdivision", "labelKey": "IDM_LAYER_SUBDIVISION",
              "children": [
                { "kind": "action", "id": "subdivision.triangleEdge", "action": "useTriangleEdgeSubdivision", "labelKey": "IDM_LAYER_SUBDIVISION_TRIANGLE_EDGE" },
                { "kind": "action", "id": "subdivision.diamondSquare", "action": "useDiamondSquareSubdivision", "labelKey": "IDM_LAYER_SUBDIVISION_DIAMOND_SQUARE" },
                { "kind": "action", "id": "subdivision.lind1996", "action": "useLind1996Subdivision", "labelKey": "IDM_LAYER_SUBDIVISION_LIND1996" }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "cameraControl.panel",
      "titleKey": "IDM_CAMERA_CONTROL_TITLE",
      "modal": false,
      "content": [
        {
          "kind": "column", "id": "cameraControlMode",
          "children": [
            { "kind": "action", "id": "cameraControl.aquynza", "action": "useAquynzaCameraControl", "labelKey": "IDM_CAMERA_CONTROL_AQUYNZA" },
            { "kind": "action", "id": "cameraControl.levelsBrowser", "action": "useLevelsBrowserCameraControl", "labelKey": "IDM_CAMERA_CONTROL_LEVELS_BROWSER" }
          ]
        }
      ]
    },
    {
      "id": "lind1996.details",
      "titleKey": "IDM_LIND1996_TITLE",
      "modal": false,
      "content": [
        { "kind": "slider", "id": "threshold", "binding": "screenErrorThresholdPixels", "labelKey": "IDM_LIND1996_THRESHOLD" },
        { "kind": "checkbox", "id": "dependenciesCrossTiles", "binding": "dependenciesCrossTiles", "labelKey": "IDM_LIND1996_DEPENDENCIES_CROSS_TILES" },
        { "kind": "label", "id": "originalTriangles", "binding": "trianglesBeforeSimplification", "labelKey": "IDM_LIND1996_ORIGINAL_TRIANGLES" },
        { "kind": "label", "id": "optimizedTriangles", "binding": "trianglesRendered", "labelKey": "IDM_LIND1996_OPTIMIZED_TRIANGLES" }
      ]
    },
    {
      "id": "imageryLevels.details",
      "titleKey": "IDM_IMAGERY_LEVELS_TITLE",
      "modal": false,
      "content": [
        { "kind": "checkbox", "id": "independentImageryLevels", "binding": "independentImageryLevels", "labelKey": "IDM_IMAGERY_LEVELS_INDEPENDENT" },
        { "kind": "label", "id": "geometryLevels", "binding": "imageryLevels", "labelKey": "IDM_IMAGERY_LEVELS_GEOMETRY_LEVELS" },
        { "kind": "label", "id": "colorLevels", "binding": "imageryLevels", "labelKey": "IDM_IMAGERY_LEVELS_COLOR_LEVELS" },
        { "kind": "label", "id": "colorBlocks", "binding": "imageryLevels", "labelKey": "IDM_IMAGERY_LEVELS_COLOR_BLOCKS" },
        { "kind": "label", "id": "colorSources", "binding": "imageryLevels", "labelKey": "IDM_IMAGERY_LEVELS_COLOR_SOURCES" }
      ]
    }
  ]
}
